{
  "name": "letmeask",
  "version": "2.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsc --noEmit && vite build",
    "build:pages": "tsc --noEmit && vite build --base=/letmeask/ && node -e \"require('fs').copyFileSync('build/index.html','build/404.html')\"",
    "preview": "vite preview",
    "test": "vitest run",
    "deploy": "npm run build && firebase deploy",
    "test:rules": "npx firebase-tools emulators:exec --only database \"vitest run --config vitest.rules.config.ts\""
  },
  "dependencies": {
    "classnames": "^2.5.1",
    "firebase": "^11.9.0",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "react-router-dom": "^7.18.4"
  },
  "devDependencies": {
    "@firebase/rules-unit-testing": "^4.0.1",
    "@testing-library/react": "^16.3.0",
    "@testing-library/user-event": "^14.6.1",
    "@types/react": "^18.3.0",
    "@types/react-dom": "^18.3.0",
    "@vitejs/plugin-react": "^6.1.1",
    "jsdom": "^26.1.0",
    "sass": "^1.89.0",
    "typescript": "^5.8.0",
    "vite": "^8.3.1",
    "vitest": "^5.0.2"
  }
}
