{
  "name": "letmeask",
  "version": "2.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsc --noEmit && vite build",
    "build:pages": "tsc --noEmit && vite build --base=/letmeask/ && node -e \"require('fs').copyFileSync('build/index.html','build/404.html')\"",
    "preview": "vite preview",
    "test": "vitest run",
    "deploy": "npm run build && firebase deploy",
    "test:rules": "npx firebase-tools@15.36.0 emulators:exec --only database \"vitest run --config vitest.rules.config.ts\"",
    "test:e2e": "npx firebase-tools@15.36.0 emulators:exec --project demo-letmeask --only auth,database \"playwright test\"",
    "typecheck:e2e": "tsc -p tsconfig.e2e.json"
  },
  "dependencies": {
    "classnames": "^2.5.1",
    "firebase": "^11.9.0",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "react-router-dom": "^7.18.5"
  },
  "devDependencies": {
    "@axe-core/playwright": "^4.14.0",
    "@firebase/rules-unit-testing": "^4.0.1",
    "@playwright/test": "^1.65.1",
    "@testing-library/react": "^16.3.0",
    "@testing-library/user-event": "^14.6.1",
    "@types/node": "^22.20.5",
    "@types/react": "^18.3.0",
    "@types/react-dom": "^18.3.0",
    "@vitejs/plugin-react": "^6.1.1",
    "jsdom": "^26.1.0",
    "sass": "^1.89.0",
    "typescript": "^5.8.0",
    "vite": "^8.3.1",
    "vitest": "^5.0.2"
  },
  "overrides": {
    "@grpc/grpc-js": "^1.14.7"
  }
}
